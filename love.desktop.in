[Desktop Entry]
Name=__LAUNCHER_NAME__
Comment=Lead Haul is a short old-school first person shooter with an emphasis on powerful weapons and a sprinkling of secret hunting.
MimeType=application/x-love-game;
Type=Application
Categories=Game;
X-Nemo-Application-Type=no-invoker
Icon=__ORGNAME__.__APPNAME__
Exec=__ORGNAME__.__APPNAME__ /usr/share/__ORGNAME__.__APPNAME__/game.love

[X-Application]
Permissions=Internet;Audio
OrganizationName=__ORGNAME__
ApplicationName=__APPNAME__

[X-Aurora-SplashScreen]
GradientStartColor=#F06923
GradientEndColor=#D72D2D

[X-Aurora-Application]
Orientation=LandscapeInverted;Landscape